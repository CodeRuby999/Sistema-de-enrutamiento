# ============== CONFIGURACIÓN DE BASE DE DATOS ==============
# 
# Para usar PostgreSQL en producción, configura esta variable con tu connection string:
# Ejemplo de Neon: postgresql://usuario:password@ep-xxx-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# Ejemplo de Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
#
# Si no se configura, la app usará SQLite local por defecto (mi_base_datos.sqlite)
DATABASE_URL=postgresql://usuario:password@host:puerto/database?sslmode=require

# ============== DESARROLLO LOCAL ==============
# Para desarrollo local con SQLite, comenta o elimina la línea DATABASE_URL
# DATABASE_URL=

# ============== PRODUCCIÓN (PythonAnywhere) ==============
# Configurar esta variable en:
# Web → Environment variables → Name: DATABASE_URL, Value: tu_connection_string

